class Output:
    """Standard output and standard error, with the count and hash of what was written."""

    def __init__(self) -> None:
        """Start with nothing written."""
        self._handles = {"stdout": sys.stdout.buffer, "stderr": sys.stderr.buffer}
        self._sizes = {"stdout": 0, "stderr": 0}
        self._hashes = {"stdout": hashlib.sha256(), "stderr": hashlib.sha256()}

    def write(self, stream: str, data: bytes) -> None:
        """Write and flush bytes to ``stdout`` or ``stderr``.

        Args:
            stream: ``stdout`` or ``stderr``.
            data: The bytes.
        """
        handle = self._handles[stream]
        handle.write(data)
        handle.flush()
        self._sizes[stream] += len(data)
        self._hashes[stream].update(data)

    def summary(self) -> dict[str, dict[str, Any]]:
        """Return the byte count and SHA-256 of each stream so far."""
        return {name: {"bytes": self._sizes[name], "sha256": self._hashes[name].hexdigest()} for name in self._sizes}


class Context(NamedTuple):
    """What a behavior works with.

    Attributes:
        settings: The checked variables.
        output: The output streams.
        record: The record's path, or ``None``.
        options: The parsed options of ``chat`` (see :func:`parse_chat`).
        token: The selftest token of the prompt, or ``None``.
    """

    settings: Settings
    output: Output
    record: str | None
    options: dict[str, Any]
    token: str | None


def noise_payload(stream: str, size: int) -> bytes:
    """Return the bytes that ``noise`` writes to one stream.

    Args:
        stream: ``stdout`` or ``stderr``.
        size: The number of bytes.

    Returns:
        The pattern of the stream, repeated and cut to ``size`` bytes.
    """
    pattern = _NOISE_PATTERNS[stream]
    return (pattern * (size // len(pattern) + 1))[:size]


def main(argv: Sequence[str] | None = None, environ: Mapping[str, str] | None = None) -> int:
    """Run one invocation.

    Args:
        argv: The argv, ``sys.argv`` by default.
        environ: The environment, ``os.environ`` by default.

    Returns:
        The exit code.
    """
    try:
        return _main(list(sys.argv if argv is None else argv), os.environ if environ is None else environ)
    except Exception:
        import traceback

        sys.stderr.write("fake kiro-cli: internal error\n" + traceback.format_exc())
        sys.stderr.flush()
        return EXIT_INTERNAL


def _main(argv: list[str], environ: Mapping[str, str]) -> int:
    """Run one invocation; see :func:`main`."""
    output = Output()
    record = environ.get("FAKE_KIRO_RECORD")
    if record is not None and not os.path.isabs(record):
        output.write("stderr", b"fake kiro-cli: FAKE_KIRO_RECORD must be an absolute path\n")
        return EXIT_USAGE
    subcommand, options, prompt, error = parse_args(argv[1:])
    token, trial, token_error = find_token(prompt)
    error = error if error is not None else token_error
    settings, settings_error = read_settings(environ, trial)
    error = error if error is not None else settings_error
    _append(
        record,
        {
            "event": "start",
            "argv": argv,
            "cwd": os.getcwd(),
            "ppid": os.getppid(),
            "pgid": os.getpgid(0),
            "sid": os.getsid(0),
            "subcommand": subcommand,
            "options": options,
            "prompt": prompt,
            "trial": trial,
            "token": token,
            "behaviors": None if settings is None else list(settings.behaviors),
            "mode_variable": None if settings is None else settings.mode_variable,
            "env": environment_summary(environ),
        },
    )
    if error is not None or settings is None:
        return _finish(record, output, EXIT_USAGE, [], f"usage: {error}")
    if subcommand == "--version":
        if "version-fail" in settings.behaviors:
            output.write("stderr", VERSION_FAIL_TEXT.encode("ascii"))
            return _finish(record, output, EXIT_NO_VERSION, [], None)
        output.write("stdout", f"kiro-cli {settings.version}\n".encode("ascii"))
        return _finish(record, output, 0, [], None)
    if subcommand == "whoami":
        if "whoami-fail" in settings.behaviors:
            output.write("stderr", NOT_LOGGED_IN_TEXT.encode("ascii"))
            return _finish(record, output, EXIT_NOT_LOGGED_IN, [], None)
        output.write("stdout", WHOAMI_TEXT.encode("ascii"))
        return _finish(record, output, 0, [], None)
    problem = chat_problem(settings, token)
    if problem is not None:
        return _finish(record, output, EXIT_USAGE, [], f"usage: {problem}")
    context = Context(settings=settings, output=output, record=record, options=options or {}, token=token)
    results: list[dict[str, Any]] = []
    for behavior in settings.behaviors:
        if behavior in WHOAMI_BEHAVIORS + VERSION_BEHAVIORS:
            continue
        result, failure = _CHAT_ACTIONS[behavior](context)
        results.append(result)
        if failure is not None:
            return _finish(record, output, EXIT_BEHAVIOR_FAILED, results, f"{behavior} failed: {failure}")
    if settings.stderr:
        output.write("stderr", settings.stderr.encode("utf-8", "surrogateescape"))
    if settings.answer:
        output.write("stdout", settings.answer.encode("utf-8", "surrogateescape"))
    return _finish(record, output, settings.exit_code, results, None)


def parse_args(args: Sequence[str]) -> tuple[str | None, dict[str, Any] | None, str | None, str | None]:
    """Read the argv after the program name.

    Args:
        args: The arguments.

    Returns:
        ``(subcommand, options, prompt, error)``. ``options`` and ``prompt`` are set for
        ``chat`` only; ``error`` is ``None`` when the arguments are usable.
    """
    if not args:
        return None, None, None, "no subcommand"
    head, rest = args[0], list(args[1:])
    if head in ("--version", "whoami"):
        return head, None, None, f"{head} takes no arguments" if rest else None
    if head != "chat":
        return head, None, None, f"unknown subcommand {head!r}"
    options, prompt, error = parse_chat(rest)
    return head, options, prompt, error


def parse_chat(args: Sequence[str]) -> tuple[dict[str, Any], str | None, str | None]:
    """Read the arguments of ``chat``.

    Args:
        args: The arguments after ``chat``.

    Returns:
        ``(options, prompt, error)``. ``options`` holds ``no_interactive`` (bool),
        ``trust_tools`` (the names, ``[]`` for ``--trust-tools=``, or ``None``),
        ``trust_all_tools`` (the form given, ``--trust-all-tools`` or ``-a``, or ``None``)
        and ``agent`` (the name or ``None``).
    """
    options: dict[str, Any] = {"no_interactive": False, "trust_tools": None, "trust_all_tools": None, "agent": None}
    positionals: list[str] = []
    index = 0
    only_positionals = False
    while index < len(args):
        arg = args[index]
        index += 1
        if only_positionals or arg == "-" or not arg.startswith("-"):
            positionals.append(arg)
        elif arg == "--":
            only_positionals = True
        elif arg == "--no-interactive":
            options["no_interactive"] = True
        elif arg.startswith("--trust-tools="):
            names = arg[len("--trust-tools=") :]
            options["trust_tools"] = names.split(",") if names else []
        elif arg in ("--trust-all-tools", "-a"):
            options["trust_all_tools"] = arg
        elif arg == "--agent":
            if index == len(args):
                return options, None, "--agent needs a name"
            options["agent"] = args[index]
            index += 1
        elif arg.startswith("--agent="):
            options["agent"] = arg[len("--agent=") :]
        else:
            return options, None, f"unknown option {arg!r}"
    if not options["no_interactive"]:
        return options, None, "chat needs --no-interactive (the fake has no interactive mode)"
    if len(positionals) != 1:
        return options, None, f"chat takes one prompt, got {len(positionals)}"
    return options, positionals[0], None


def find_token(prompt: str | None) -> tuple[str | None, str | None, str | None]:
    """Find the selftest token of a prompt.

    Args:
        prompt: The prompt of ``chat``, or ``None`` for the other invocations.

    Returns:
        ``(token, trial, None)``, ``(None, None, None)`` when the prompt holds no token, or
        ``(None, None, error)`` when it holds more than one different token.
    """
    if prompt is None:
        return None, None, None
    found = {match.group(0): match.group(1) for match in SELFTEST_TOKEN.finditer(prompt)}
    if len(found) > 1:
        return None, None, f"the prompt holds {len(found)} different selftest tokens: {', '.join(sorted(found))}"
    if not found:
        return None, None, None
    ((token, trial),) = found.items()
    return token, trial, None


def read_settings(environ: Mapping[str, str], trial: str | None = None) -> tuple[Settings | None, str | None]:
    """Check the ``FAKE_KIRO_*`` variables.

    Args:
        environ: The environment.
        trial: The selftest trial of the prompt, ``t0`` to ``t4``, or ``None``.

    Returns:
        ``(settings, None)``, or ``(None, error)`` for the first unusable variable.
    """
    mode_variable = "FAKE_KIRO_MODE"
    behaviors, error = _behaviors(environ, mode_variable)
    if error is not None:
        return None, error
    for name in sorted(environ):
        if not name.startswith(TRIAL_MODE_PREFIX):
            continue
        suffix = name[len(TRIAL_MODE_PREFIX) :]
        if suffix not in TRIAL_SUFFIXES:
            return None, f"{name} names no trial: the per-trial variables are {TRIAL_MODE_PREFIX}T0 to T4"
        chosen, error = _behaviors(environ, name)
        if error is not None:
            return None, error
        if trial is not None and suffix == trial.upper():
            mode_variable, behaviors = name, chosen
    try:
        exit_code = int(environ.get("FAKE_KIRO_EXIT_CODE", "0"))
        sleep_seconds = float(environ.get("FAKE_KIRO_SLEEP_SECONDS", str(DEFAULT_SLEEP_SECONDS)))
        noise_bytes = int(environ.get("FAKE_KIRO_NOISE_BYTES", str(DEFAULT_NOISE_BYTES)))
    except ValueError as error:
        return None, f"a FAKE_KIRO_* number does not parse: {error}"
    if not 0 <= exit_code <= 255:
        return None, "FAKE_KIRO_EXIT_CODE must be from 0 to 255"
    if not (math.isfinite(sleep_seconds) and sleep_seconds > 0):
        return None, "FAKE_KIRO_SLEEP_SECONDS must be a finite number above 0"
    if noise_bytes < 0:
        return None, "FAKE_KIRO_NOISE_BYTES must be 0 or more"
    raw_files = environ.get("FAKE_KIRO_COMMIT_FILES")
    commit_files = DEFAULT_COMMIT_FILES if raw_files is None else tuple(raw_files.split(","))
    for path in commit_files:
        parts = path.split("/")
        if path.startswith("/") or any(part in ("", ".", "..", ".git") for part in parts):
            return None, f"FAKE_KIRO_COMMIT_FILES holds a path outside the working directory: {path!r}"
    raw_gh_exit = environ.get("FAKE_KIRO_GH_EXIT")
    if raw_gh_exit is None:
        gh_exit = 0 if any(environ.get(name) for name in GH_TOKEN_VARIABLES) else GH_NOT_LOGGED_IN
        gh_exit_source = "token_variables"
    else:
        try:
            gh_exit = int(raw_gh_exit)
        except ValueError:
            return None, f"FAKE_KIRO_GH_EXIT does not parse as an integer: {raw_gh_exit!r}"
        if not 0 <= gh_exit <= 255:
            return None, "FAKE_KIRO_GH_EXIT must be from 0 to 255"
        gh_exit_source = "FAKE_KIRO_GH_EXIT"
    version = environ.get("FAKE_KIRO_VERSION", DEFAULT_VERSION)
    if VERSION_FORM.fullmatch(version) is None:
        return None, f"FAKE_KIRO_VERSION must be printable ASCII without white space, got {version!r}"
    return (
        Settings(
            behaviors=behaviors,
            answer=environ.get("FAKE_KIRO_ANSWER", DEFAULT_ANSWER),
            exit_code=exit_code,
            sleep_seconds=sleep_seconds,
            noise_bytes=noise_bytes,
            commit_files=commit_files,
            mode_variable=mode_variable,
            gh_exit=gh_exit,
            gh_exit_source=gh_exit_source,
            guard_log=environ.get(GUARD_LOG_VARIABLE),
            version=version,
            stderr=environ.get("FAKE_KIRO_STDERR", ""),
        ),
        None,
    )


def _behaviors(environ: Mapping[str, str], name: str) -> tuple[tuple[str, ...], str | None]:
    """Read one variable of behaviors separated by commas.

    Args:
        environ: The environment.
        name: ``FAKE_KIRO_MODE`` or a per-trial variable.

    Returns:
        ``(behaviors, None)``, or ``((), error)`` when it names an unknown behavior.
    """
    behaviors = tuple(part.strip() for part in environ.get(name, "").split(",") if part.strip())
    unknown = [part for part in behaviors if part not in WHOAMI_BEHAVIORS + VERSION_BEHAVIORS + CHAT_BEHAVIORS]
    if unknown:
        return (), f"unknown behavior in {name}: {', '.join(unknown)}"
    return behaviors, None


def chat_problem(settings: Settings, token: str | None) -> str | None:
    """Say why the behaviors of a ``chat`` cannot run, or return ``None``.

    Checked for ``chat`` only, so that ``whoami`` and ``--version`` behave as before
    whatever the selftest variables hold.

    Args:
        settings: The checked variables.
        token: The selftest token of the prompt, or ``None``.

    Returns:
        The problem: a behavior of :data:`TOKEN_BEHAVIORS` without a token, or a guard
        behavior with ``HANDOFF_GUARD_LOG`` set to a path that is not absolute.
    """
    needing = [behavior for behavior in settings.behaviors if behavior in TOKEN_BEHAVIORS]
    if needing and token is None:
        return f"{', '.join(needing)} needs a selftest token in the prompt"
    uses_log = any(behavior in GUARD_BEHAVIORS for behavior in settings.behaviors)
    if uses_log and settings.guard_log is not None and not os.path.isabs(settings.guard_log):
        return f"{GUARD_LOG_VARIABLE} must be an absolute path, got {settings.guard_log!r}"
    return None


def environment_summary(environ: Mapping[str, str]) -> dict[str, Any]:
    """Summarize the environment for the record, without the values of secrets.

    Args:
        environ: The environment.

    Returns:
        The variable names, the push URL override, and the state of the files that
        ``child_env`` points at. See the module docstring.
    """
    git_config = {
        name: value
        for name, value in environ.items()
        if name == "GIT_CONFIG_COUNT"
        or any(
            name.startswith(prefix) and name[len(prefix) :].isascii() and name[len(prefix) :].isdigit()
            for prefix in _GIT_CONFIG_NUMBERED
        )
    }
    return {
        "names": sorted(environ),
        "git_config": {name: git_config[name] for name in sorted(git_config)},
        "gh_config_dir": _directory_state(environ.get("GH_CONFIG_DIR")),
        "aws_config_file": _file_state(environ.get("AWS_CONFIG_FILE")),
        "aws_shared_credentials_file": _file_state(environ.get("AWS_SHARED_CREDENTIALS_FILE")),
        "aws_ec2_metadata_disabled": environ.get("AWS_EC2_METADATA_DISABLED") == "true",
        "path_first_sha256": hashlib.sha256(
            environ.get("PATH", "").split(":")[0].encode("utf-8")
        ).hexdigest(),
    }


def _directory_state(path: str | None) -> str:
    """Say whether a path is an empty directory: ``unset``, ``empty``, ``not_empty``, ``not_a_directory`` or ``missing``."""
    if path is None:
        return "unset"
    if os.path.isdir(path):
        return "not_empty" if os.listdir(path) else "empty"
    return "not_a_directory" if os.path.lexists(path) else "missing"


def _file_state(path: str | None) -> str:
    """Say whether a path is an empty file: ``unset``, ``empty``, ``not_empty``, ``not_a_file`` or ``missing``."""
    if path is None:
        return "unset"
    if os.path.isfile(path):
        return "not_empty" if os.path.getsize(path) else "empty"
    return "not_a_file" if os.path.lexists(path) else "missing"


def _noise(context: Context) -> tuple[dict[str, Any], str | None]:
    """Write the noise payloads to both streams, in alternating chunks."""
    size = context.settings.noise_bytes
    payloads = {stream: noise_payload(stream, size) for stream in ("stdout", "stderr")}
    for start in range(0, size, NOISE_CHUNK):
        for stream in ("stdout", "stderr"):
            context.output.write(stream, payloads[stream][start : start + NOISE_CHUNK])
    return {
        "behavior": "noise",
        "bytes": size,
        "sha256": {stream: hashlib.sha256(payload).hexdigest() for stream, payload in payloads.items()},
    }, None


def _ignore_sigterm(context: Context) -> tuple[dict[str, Any], str | None]:
    """Ignore SIGTERM in this process and in the children it starts from now on."""
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    return {"behavior": "ignore-sigterm"}, None


def _sleep(context: Context) -> tuple[dict[str, Any], str | None]:
    """Start a sleeping child in this process group, record its PID once it runs, sleep, then reap it.

    The child writes one byte to a pipe when its code starts, and the ``spawned`` event waits
    for that byte. A signal sent after the event therefore reaches a child that runs its own
    code, not one that is still starting up.
    """
    seconds = context.settings.sleep_seconds
    ready_read, ready_write = os.pipe()
    child = subprocess.Popen(
        [sys.executable, "-c", _CHILD_CODE, repr(seconds + CHILD_EXTRA_SECONDS), str(ready_write)],
        stdin=subprocess.DEVNULL,
        pass_fds=(ready_write,),
    )
    os.close(ready_write)
    try:
        ready = os.read(ready_read, 1) == b"r"
    finally:
        os.close(ready_read)
    try:
        child_pgid: int | None = os.getpgid(child.pid)
    except ProcessLookupError:
        child_pgid = None
    _append(
        context.record, {"event": "spawned", "child_pid": child.pid, "child_pgid": child_pgid, "child_ready": ready}
    )
    time.sleep(seconds)
    child.kill()
    child.wait()
    return {"behavior": "sleep", "seconds": seconds, "child_pid": child.pid}, None


def _commit(context: Context) -> tuple[dict[str, Any], str | None]:
    """Change and commit ``FAKE_KIRO_COMMIT_FILES``."""
    return _commit_files("commit", context.settings.commit_files)


def _undeclared(context: Context) -> tuple[dict[str, Any], str | None]:
    """Change and commit the file that the tests do not declare."""
    return _commit_files("undeclared", (UNDECLARED_FILE,))


def _commit_files(behavior: str, files: Sequence[str]) -> tuple[dict[str, Any], str | None]:
    """Append :data:`CHANGE_LINE` to each file and commit the files in the working directory.

    Args:
        behavior: The behavior's name, for the result.
        files: Paths relative to the working directory.

    Returns:
        The result and ``None``, or the result so far and what failed.
    """
    result: dict[str, Any] = {"behavior": behavior, "files": list(files), "commit": None, "steps": []}
    for relative in files:
        path = os.path.join(os.getcwd(), *relative.split("/"))
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "ab") as handle:
                handle.write(CHANGE_LINE)
        except OSError as error:
            return result, f"cannot write {relative}: {error.strerror}"
    for args in (["add", "--", *files], ["commit", "-q", "-m", COMMIT_MESSAGE]):
        completed = _git(args)
        result["steps"].append(_step(completed))
        if completed.returncode != 0:
            return result, f"git {args[0]} exited {completed.returncode}"
    head = _git(["rev-parse", "HEAD"])
    result["commit"] = _text(head) if head.returncode == 0 else None
    return result, None


def _push(context: Context) -> tuple[dict[str, Any], str | None]:
    """Try to push the current branch to ``origin``."""
    return _push_to(to_url=False)


def _push_url(context: Context) -> tuple[dict[str, Any], str | None]:
    """Try to push the current branch to the URL of ``remote.origin.url``."""
    return _push_to(to_url=True)


def _push_to(*, to_url: bool) -> tuple[dict[str, Any], str | None]:
    """Push ``HEAD`` to the current branch's name and see whether the ref arrived.

    Args:
        to_url: Push to the URL in ``remote.origin.url`` rather than to ``origin``.

    Returns:
        The result and ``None``, or the result so far and what failed. A refused push is a
        result: ``exit_code`` is not 0 and ``arrived`` is false.
    """
    branch = _git(["symbolic-ref", "--quiet", "--short", "HEAD"])
    ref = "refs/heads/" + (_text(branch) if branch.returncode == 0 and _text(branch) else DETACHED_PUSH_BRANCH)
    url_run = _git(["config", "--get", "remote.origin.url"])
    url = _text(url_run) if url_run.returncode == 0 and _text(url_run) else None
    result: dict[str, Any] = {
        "behavior": "push-url" if to_url else "push",
        "destination": "url" if to_url else "origin",
        "ref": ref,
        "local_sha": _text(_git(["rev-parse", "HEAD"])),
        "exit_code": None,
        "stderr": None,
        "remote_sha_before": None,
        "remote_sha_after": None,
        "arrived": None,
    }
    if url is None:
        return result, "remote.origin.url is not set"
    before, problem = _remote_sha(url, ref)
    if problem is not None:
        return result, problem
    pushed = _git(["push", url if to_url else "origin", "HEAD:" + ref])
    after, problem = _remote_sha(url, ref)
    result.update(
        {
            "exit_code": pushed.returncode,
            "stderr": _tail(pushed.stderr),
            "remote_sha_before": before,
            "remote_sha_after": after,
            "arrived": after is not None and after == result["local_sha"],
        }
    )
    return result, problem


def _remote_sha(url: str, ref: str) -> tuple[str | None, str | None]:
    """Read one ref of a remote with ``git ls-remote``.

    Args:
        url: The remote's URL.
        ref: The full ref name.

    Returns:
        ``(sha, None)`` with ``sha`` ``None`` when the remote has no such ref, or
        ``(None, error)`` when ``ls-remote`` fails.
    """
    listed = _git(["ls-remote", url, ref])
    if listed.returncode != 0:
        return None, f"git ls-remote exited {listed.returncode}"
    for line in _text(listed).splitlines():
        sha, _, name = line.partition("\t")
        if name == ref:
            return sha, None
    return None, None


def _switch_main(context: Context) -> tuple[dict[str, Any], str | None]:
    """Create and switch to :data:`SWITCH_BRANCH` in the repository's main working tree."""
    result: dict[str, Any] = {
        "behavior": "switch-main",
        "main_tree": None,
        "branch_before": None,
        "branch_after": None,
        "exit_code": None,
        "stderr": None,
    }
    listing = _git(["worktree", "list", "--porcelain"])
    first = _text(listing).splitlines()[:1] if listing.returncode == 0 else []
    if not first or not first[0].startswith("worktree "):
        return result, "git worktree list did not name the main working tree"
    main_tree = first[0][len("worktree ") :]
    result["main_tree"] = main_tree
    result["branch_before"] = _text(_git(["-C", main_tree, "branch", "--show-current"])) or None
    switched = _git(["-C", main_tree, "switch", "-q", "-c", SWITCH_BRANCH])
    result["exit_code"] = switched.returncode
    result["branch_after"] = _text(_git(["-C", main_tree, "branch", "--show-current"])) or None
    if switched.returncode != 0:
        result["stderr"] = _tail(switched.stderr)
        return result, f"git switch exited {switched.returncode}"
    return result, None


def _label(context: Context) -> str:
    """Return the token of the prompt, or :data:`NO_TOKEN_LABEL` when it holds none."""
    return context.token if context.token is not None else NO_TOKEN_LABEL


def _empty_commit(context: Context) -> tuple[dict[str, Any], str | None]:
    """T1: commit nothing with a message that holds the token and a private-range example address."""
    return _commit_empty("empty-commit", f"{_label(context)} {EXAMPLE_ADDRESS}")


def _gh_status(context: Context) -> tuple[dict[str, Any], str | None]:
    """T3: stand for ``gh auth status`` and commit its code, as ``gh auth status; git commit ... gh-exit=$?`` would."""
    code = context.settings.gh_exit
    result, failure = _commit_empty("gh-status", f"{_label(context)} gh-exit={code}")
    result.update({"gh_exit": code, "source": context.settings.gh_exit_source})
    return result, failure


def _commit_empty(behavior: str, message: str) -> tuple[dict[str, Any], str | None]:
    """Make a commit without changes in the working directory.

    Args:
        behavior: The behavior's name, for the result.
        message: The commit message.

    Returns:
        The result and ``None``, or the result so far and what failed.
    """
    result: dict[str, Any] = {"behavior": behavior, "message": message, "commit": None, "steps": []}
    completed = _git(["commit", "-q", "--allow-empty", "-m", message])
    result["steps"].append(_step(completed))
    if completed.returncode != 0:
        return result, f"git commit exited {completed.returncode}"
    head = _git(["rev-parse", "HEAD"])
    result["commit"] = _text(head) if head.returncode == 0 else None
    return result, None


def _write_file(context: Context) -> tuple[dict[str, Any], str | None]:
    """T4: write ``<token>.txt`` only when the argv trusts :data:`WRITE_TOOL`."""
    return _write_token_file("write-file", context, honor_trust=True)


def _write_file_anyway(context: Context) -> tuple[dict[str, Any], str | None]:
    """T4: write ``<token>.txt`` whatever the argv trusts."""
    return _write_token_file("write-file-anyway", context, honor_trust=False)


def _write_token_file(behavior: str, context: Context, *, honor_trust: bool) -> tuple[dict[str, Any], str | None]:
    """Append :data:`CHANGE_LINE` to ``<token>.txt`` in the working directory, unless the allowlist forbids it.

    Args:
        behavior: The behavior's name, for the result.
        context: The run.
        honor_trust: Write only when the argv trusts :data:`WRITE_TOOL`.

    Returns:
        The result and ``None``, or the result so far and what failed. A refusal is a
        result: ``trusted`` and ``written`` are false.
    """
    name = _label(context) + ".txt"
    trusted = _trusts(context.options, WRITE_TOOL)
    result: dict[str, Any] = {
        "behavior": behavior,
        "file": name,
        "tool": WRITE_TOOL,
        "trusted": trusted,
        "written": False,
    }
    if honor_trust and not trusted:
        return result, None
    try:
        with open(os.path.join(os.getcwd(), name), "ab") as handle:
            handle.write(CHANGE_LINE)
    except OSError as error:
        return result, f"cannot write {name}: {error.strerror}"
    result["written"] = True
    return result, None


def _trusts(options: Mapping[str, Any], tool: str) -> bool:
    """Say whether the parsed ``chat`` options trust a tool: by name in ``--trust-tools``, or all of them."""
    if options.get("trust_all_tools") is not None:
        return True
    names = options.get("trust_tools")
    return names is not None and tool in names


def _guard_block(context: Context) -> tuple[dict[str, Any], str | None]:
    """Log a stopped tool call whose input holds the token."""
    return _guard_entry("guard-block", context, decision="block", with_token=True)


def _guard_allow(context: Context) -> tuple[dict[str, Any], str | None]:
    """Log a tool call that the guard let through, whose input holds the token."""
    return _guard_entry("guard-allow", context, decision="allow", with_token=True)


def _guard_block_other(context: Context) -> tuple[dict[str, Any], str | None]:
    """Log a stopped tool call whose input does not hold the token."""
    return _guard_entry("guard-block-other", context, decision="block", with_token=False)


def _guard_entry(
    behavior: str, context: Context, *, decision: str, with_token: bool
) -> tuple[dict[str, Any], str | None]:
    """Append one entry of the guard wrapper to ``HANDOFF_GUARD_LOG``, if it is set.

    Args:
        behavior: The behavior's name, for the result.
        context: The run. With ``with_token``, :func:`chat_problem` made sure that the
            prompt holds a token.
        decision: ``block`` (the guard exited 2) or ``allow`` (it exited 0).
        with_token: Put the token in the call's input.

    Returns:
        The result and ``None``, or the result so far and what failed. Without the
        variable, ``written`` is false and nothing is written anywhere.
    """
    command = f"fake-kiro-cli selftest operation {context.token}" if with_token else UNRELATED_COMMAND
    log = context.settings.guard_log
    result: dict[str, Any] = {
        "behavior": behavior,
        "guard": FAKE_GUARD,
        "decision": decision,
        "log": log,
        "written": False,
        "token_in_input": with_token,
    }
    if log is None:
        return result, None
    entry = {
        "schema": GUARD_SCHEMA_VERSION,
        "at": _stamp(),
        "guard": FAKE_GUARD,
        "decision": decision,
        "exit_code": 2 if decision == "block" else 0,
        "input": {
            "hook_event_name": "preToolUse",
            "cwd": os.getcwd(),
            "tool_name": FAKE_TOOL,
            "tool_input": {"command": command},
        },
    }
    try:
        _locked_append(log, json.dumps(entry, ensure_ascii=True))
    except OSError as error:
        return result, f"cannot append to {GUARD_LOG_VARIABLE}: {error.strerror}"
    result["written"] = True
    return result, None


_CHAT_ACTIONS: dict[str, Callable[[Context], tuple[dict[str, Any], str | None]]] = {
    "noise": _noise,
    "ignore-sigterm": _ignore_sigterm,
    "sleep": _sleep,
    "commit": _commit,
    "undeclared": _undeclared,
    "push": _push,
    "push-url": _push_url,
    "switch-main": _switch_main,
    "empty-commit": _empty_commit,
    "gh-status": _gh_status,
    "write-file": _write_file,
    "write-file-anyway": _write_file_anyway,
    "guard-block": _guard_block,
    "guard-allow": _guard_allow,
    "guard-block-other": _guard_block_other,
}


def _git(args: Sequence[str]) -> subprocess.CompletedProcess[bytes]:
    """Run git in the working directory with this process's environment."""
    return subprocess.run(["git", *args], stdin=subprocess.DEVNULL, capture_output=True, check=False)


def _text(completed: subprocess.CompletedProcess[bytes]) -> str:
    """Return a git command's standard output as text, stripped."""
    return os.fsdecode(completed.stdout).strip()


def _tail(data: bytes) -> str:
    """Return the end of a git command's standard error as text."""
    return data.decode("utf-8", "replace")[-TAIL_CHARS:]


def _step(completed: subprocess.CompletedProcess[bytes]) -> dict[str, Any]:
    """Describe one git command of a behavior for the record."""
    step: dict[str, Any] = {"argv": list(completed.args), "exit_code": completed.returncode}
    if completed.returncode != 0:
        step["stderr"] = _tail(completed.stderr)
    return step


def _finish(record: str | None, output: Output, code: int, results: list[dict[str, Any]], error: str | None) -> int:
    """Write the error, append the ``end`` event, and return the exit code."""
    if error is not None:
        output.write("stderr", f"fake kiro-cli: {error}\n".encode("utf-8", "replace"))
    _append(record, {"event": "end", "exit_code": code, "results": results, "error": error, **output.summary()})
    return code


def _append(record: str | None, event: dict[str, Any]) -> None:
    """Append one event to the record, under an exclusive lock.

    Args:
        record: The record's absolute path, or ``None`` to record nothing.
        event: The event. ``schema``, ``at`` and ``pid`` are added.
    """
    if record is None:
        return
    line = json.dumps({"schema": SCHEMA_VERSION, "at": _stamp(), "pid": os.getpid(), **event}, ensure_ascii=True)
    _locked_append(record, line)


def _stamp() -> str:
    """Return the time now in UTC, to the microsecond."""
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


def _locked_append(path: str, line: str) -> None:
    """Append one ASCII line and a newline to a file, under an exclusive ``flock``.

    Args:
        path: The file's absolute path; it is created with mode 0600 if missing.
        line: The line, without its newline.
    """
    data = memoryview((line + "\n").encode("ascii"))
    descriptor = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        while data:
            data = data[os.write(descriptor, data) :]
    finally:
        os.close(descriptor)


