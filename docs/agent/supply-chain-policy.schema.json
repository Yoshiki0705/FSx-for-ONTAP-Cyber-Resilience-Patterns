{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yoshiki0705/FSx-for-ONTAP-Cyber-Resilience-Patterns/blob/main/docs/agent/supply-chain-policy.schema.json",
  "title": "Supply-chain policy (pillar 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_repositories",
    "excluded_repositories",
    "opening_threshold",
    "cooldown_days",
    "dependency_scope",
    "automerge",
    "vex",
    "response_target",
    "issue_limits"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "target_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repo"}
    },
    "excluded_repositories": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repo"}
    },
    "opening_threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_cvss_severity", "open_if_kev_listed", "open_if_malicious", "epss_used_for_opening"],
      "properties": {
        "min_cvss_severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "open_if_kev_listed": {"type": "boolean"},
        "open_if_malicious": {"const": true},
        "epss_used_for_opening": {"const": false}
      }
    },
    "cooldown_days": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "major"],
      "properties": {
        "default": {"type": "integer", "minimum": 1},
        "major": {"type": "integer", "minimum": 1}
      }
    },
    "package_manager_wait": {
      "description": "Optional. The package manager's waiting period is one value for every update (no separate value for major updates), derived from cooldown_days.default; a file that writes it must write the same value (T1-15, Requirement 12.21).",
      "type": "object",
      "additionalProperties": false,
      "required": ["default_days"],
      "properties": {
        "default_days": {"type": "integer", "minimum": 1}
      }
    },
    "dependency_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_production_paths"],
      "properties": {
        "non_production_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "automerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude", "enabled_repositories"],
      "properties": {
        "enabled_repositories": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repo"}
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manager", "update_types"],
            "properties": {
              "manager": {"enum": ["npm", "github-actions"]},
              "dep_types": {"type": "array", "items": {"enum": ["devDependencies"]}},
              "update_types": {"type": "array", "items": {"const": "patch"}, "minItems": 1}
            }
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "vulnerability_fix",
              "runtime_dependencies",
              "minor",
              "major",
              "digest_only",
              "unknown_dep_type",
              "hub_reusable_workflow",
              "third_party_action"
            ]
          },
          "contains": {"const": "vulnerability_fix"}
        }
      }
    },
    "vex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "exclude_statuses",
        "approver_role",
        "one_statement_per_document",
        "malicious_never_suppressed"
      ],
      "properties": {
        "directory": {"const": ".vex"},
        "exclude_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["not_affected", "fixed"]},
          "minItems": 1
        },
        "approver_role": {"const": "VEX_Reviewer"},
        "one_statement_per_document": {"const": true},
        "malicious_never_suppressed": {"const": true},
        "max_age_days": {"type": "integer", "minimum": 1}
      }
    },
    "response_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detect_hours", "fix_days_kev_or_malicious", "fix_days_high"],
      "properties": {
        "detect_hours": {"type": "integer", "minimum": 1},
        "fix_days_kev_or_malicious": {"type": "integer", "minimum": 1},
        "fix_days_high": {"type": "integer", "minimum": 1}
      }
    },
    "renovate_preset": {
      "description": "Optional. The Hub preset tag a Spoke trusts and the commit that tag pointed at when it was recorded (T1-06).",
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "unscored_review_days": {
      "description": "Optional (default 7). Days a Finding may stay without a severity before the per-repository unscored Issue lists it (T2-07). Does not change the Opening_Threshold.",
      "type": "integer",
      "minimum": 1
    },
    "watchdog": {
      "description": "Optional. The watchdog fails when the newest Run_Record is older than limit_hours (default 8: the Aggregator interval of at most 6 hours plus 2 hours of scheduler delay, Requirement 7.2).",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "limit_hours": {"type": "integer", "minimum": 1}
      }
    },
    "issue_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_new_issues_per_repo_per_run"],
      "properties": {
        "max_new_issues_per_repo_per_run": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  },
  "$defs": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
    }
  }
}
