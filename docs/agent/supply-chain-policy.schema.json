{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yoshiki0705/FSx-for-ONTAP-Cyber-Resilience-Patterns/blob/main/docs/agent/supply-chain-policy.schema.json",
  "title": "Supply-chain policy (pillar 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_repositories",
    "excluded_repositories",
    "opening_threshold",
    "cooldown_days",
    "package_manager_wait",
    "dependency_scope",
    "automerge",
    "vex",
    "response_target",
    "issue_limits"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "target_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repo"}
    },
    "excluded_repositories": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repo"}
    },
    "opening_threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_cvss_severity", "open_if_kev_listed", "open_if_malicious", "epss_used_for_opening"],
      "properties": {
        "min_cvss_severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "open_if_kev_listed": {"type": "boolean"},
        "open_if_malicious": {"const": true},
        "epss_used_for_opening": {"const": false}
      }
    },
    "cooldown_days": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "major"],
      "properties": {
        "default": {"type": "integer", "minimum": 1},
        "major": {"type": "integer", "minimum": 1}
      }
    },
    "package_manager_wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_days", "major_days"],
      "properties": {
        "default_days": {"type": "integer", "minimum": 1},
        "major_days": {"type": "integer", "minimum": 1}
      }
    },
    "dependency_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_production_paths"],
      "properties": {
        "non_production_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "automerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude", "enabled_repositories"],
      "properties": {
        "enabled_repositories": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repo"}
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manager", "update_types"],
            "properties": {
              "manager": {"enum": ["npm", "github-actions"]},
              "dep_types": {"type": "array", "items": {"enum": ["devDependencies"]}},
              "update_types": {"type": "array", "items": {"const": "patch"}, "minItems": 1}
            }
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "vulnerability_fix",
              "runtime_dependencies",
              "minor",
              "major",
              "digest_only",
              "unknown_dep_type",
              "hub_reusable_workflow"
            ]
          },
          "contains": {"const": "vulnerability_fix"}
        }
      }
    },
    "vex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "exclude_statuses",
        "approver_role",
        "one_statement_per_document",
        "malicious_never_suppressed"
      ],
      "properties": {
        "directory": {"const": ".vex"},
        "exclude_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["not_affected", "fixed"]},
          "minItems": 1
        },
        "approver_role": {"const": "VEX_Reviewer"},
        "one_statement_per_document": {"const": true},
        "malicious_never_suppressed": {"const": true}
      }
    },
    "response_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detect_hours", "fix_days_kev_or_malicious", "fix_days_high"],
      "properties": {
        "detect_hours": {"type": "integer", "minimum": 1},
        "fix_days_kev_or_malicious": {"type": "integer", "minimum": 1},
        "fix_days_high": {"type": "integer", "minimum": 1}
      }
    },
    "issue_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_new_issues_per_repo_per_run"],
      "properties": {
        "max_new_issues_per_repo_per_run": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  },
  "$defs": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
    }
  }
}
