        <mxCell id="c6" value="&lt;b&gt;Hub の Kiro ※1&lt;/b&gt;&lt;br&gt;kiro-cli 2.32.0（非対話）&lt;br&gt;macOS 27.0&lt;br&gt;エージェント設定 handoff-change&lt;br&gt;hooks.preToolUse のガード" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#E6EDF3;strokeWidth=1;fontSize=16;fontColor=#E6EDF3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
