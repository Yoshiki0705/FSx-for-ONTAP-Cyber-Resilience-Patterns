        <mxCell id="c27" value="凡例と補足" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA7B8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=16;fontColor=#E6EDF3;" parent="1" vertex="1">
