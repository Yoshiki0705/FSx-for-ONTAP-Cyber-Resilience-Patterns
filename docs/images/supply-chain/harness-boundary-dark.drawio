        <mxCell id="c20" value="ブランチと項目専用のオブジェクトは消さない" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#FF8A80;strokeWidth=1;fontSize=16;fontColor=#FF8A80;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
