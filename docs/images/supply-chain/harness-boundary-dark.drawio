        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;取り込み&lt;/b&gt;&lt;br&gt;unpack-objects --strict&lt;br&gt;完了は commit と差分で判定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#E6EDF3;strokeWidth=1;fontSize=16;fontColor=#E6EDF3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
