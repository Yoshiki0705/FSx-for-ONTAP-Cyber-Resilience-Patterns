        <mxCell id="c17" value="&lt;b&gt;検査&lt;/b&gt;&lt;br&gt;宣言ファイル以外の変更&lt;br&gt;.git の形&lt;br&gt;gitlink（160000）&lt;br&gt;実行面の走査（zizmor、gitleaks）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#E6EDF3;strokeWidth=1;fontSize=16;fontColor=#E6EDF3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
