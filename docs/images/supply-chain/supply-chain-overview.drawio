        <mxCell id="c34" value="&lt;b&gt;インフラ構成要素の一覧&lt;/b&gt;&lt;br&gt;（JSON ファイル）&lt;br&gt;ONTAP の版&lt;br&gt;Amazon FSx for NetApp ONTAP のデプロイタイプ&lt;br&gt;TrendAI、Deep Instinct の版" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontSize=16;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
