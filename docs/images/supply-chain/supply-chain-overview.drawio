        <mxCell id="c33" value="構成要素の一覧とアドバイザリの照合" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6B86;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=16;fontColor=#232F3E;" parent="1" vertex="1">
          <mxGeometry x="640" y="640" width="290" height="375" as="geometry" />
