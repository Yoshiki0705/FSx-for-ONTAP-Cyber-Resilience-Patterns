        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;Issue（各リポジトリ）&lt;/b&gt;&lt;br&gt;対応時間の目標: 検出 24 時間、修正 7 日（KEV または悪意）・14 日（High 以上）&lt;br&gt;supply-chain-aggregator ラベル" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontSize=16;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="650" y="400" width="270" height="160" as="geometry" />
