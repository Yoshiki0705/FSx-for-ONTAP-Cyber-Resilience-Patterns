        </mxCell>
        <mxCell id="c35" value="&lt;b&gt;NetApp のセキュリティ&lt;/b&gt;&lt;br&gt;&lt;b&gt;アドバイザリ（RSS）&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontSize=16;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="650" y="840" width="270" height="70" as="geometry" />
        </mxCell>
