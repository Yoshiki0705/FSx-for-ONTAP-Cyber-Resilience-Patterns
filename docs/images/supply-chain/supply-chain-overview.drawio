          <mxGeometry x="650" y="925" width="270" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="失敗時: Hub の障害 Issue に追記&lt;br&gt;（開いたものがなければ起票）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontSize=16;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="650" y="1051" width="270" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="凡例と補足" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6B86;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=16;fontColor=#232F3E;" parent="1" vertex="1">
          <mxGeometry x="20" y="1253" width="900" height="380" as="geometry" />
        </mxCell>
        <mxCell id="c39" value="① 取得経路 A: 依存関係グラフと Dependabot アラートを API で取得（アラートの助言の出どころは GitHub Advisory Database）&lt;br&gt;② 取得経路 B: パイロット 2 件が sbom-generate を呼び、SBOM を集約ジョブへ渡す&lt;br&gt;③ 外部フィード（KEV、EPSS、OSV）を取得&lt;br&gt;④ 起票の条件を満たした所見を Issue に起票&lt;br&gt;⑤ 実行結果を supply-chain-runs に追記（直前の記録のハッシュを持つ）&lt;br&gt;⑥ 見張りが記録の新しさと連鎖を確認&lt;br&gt;⑦ 保守者の機械が Hub のワークフロー一覧と記録を確認（見張り自身の停止も拾う）&lt;br&gt;⑧ 集約ジョブが承認済みの VEX の判断を読む&lt;br&gt;⑨ Renovate が更新 PR を作る&lt;br&gt;⑩ 構成要素の一覧とアドバイザリを人が照合（破線）&lt;br&gt;実線の矢印: 自動の流れ。破線の矢印と枠: 人の手順、または任意・未有効。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=16;fontColor=#232F3E;spacingLeft=4;spacingRight=4;" parent="1" vertex="1">
          <mxGeometry x="30" y="1287" width="880" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;※1 数値は設定値&lt;/b&gt;&lt;br&gt;12 件、6 時間、8 時間、3 日・7 日、24 時間、180 日、1 回 10 件はポリシーの設定値（2026-11-17 時点）。測定値ではない。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=16;fontColor=#232F3E;spacingLeft=4;spacingRight=4;" parent="1" vertex="1">
          <mxGeometry x="30" y="1549" width="880" height="70" as="geometry" />
