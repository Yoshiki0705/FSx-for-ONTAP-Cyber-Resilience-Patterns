        <mxCell id="c29" value="&lt;b&gt;Renovate&lt;/b&gt;（Mend 提供）&lt;br&gt;Hub の共有プリセットを extends&lt;br&gt;待ち時間: 通常 3 日、メジャー 7 日" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontSize=16;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
